# ─────────────────────────────────────────────────────────────────────
# AllDap 루트 환경변수 예시
#
# 사용법: 이 파일을 복사해 .env 로 만들고 값을 채운다.
#   cp .env.example .env
# .env 는 커밋하지 않는다(.gitignore 대상). 여기엔 실제 시크릿을 넣지 말 것.
#
# 여기 있는 값은 Spring API(api/) 가 읽는다.
# Python AI 서비스(ai-service/) 는 자기 디렉터리의 .env 를 따로 쓴다.
#   → ai-service/.env.example 참고 (DATABASE_URL, OPENAI_API_KEY,
#     ANTHROPIC_API_KEY, EMBEDDING_MODEL 등)
#   LLM API 키는 전부 ai-service/.env 소관이다. 이 파일엔 두지 않는다.
# ─────────────────────────────────────────────────────────────────────

# ── DB ───────────────────────────────────────────────────────────────
# docker-compose.yml 의 db 서비스 기본값과 동일하다.
# 로컬 개발이라면 아래 값 그대로 쓰면 된다.
# 포트는 127.0.0.1 에만 열려 있으므로 같은 머신에서만 접속된다.
DB_URL=jdbc:postgresql://localhost:5432/alldap
DB_USERNAME=alldap
DB_PASSWORD=alldap

# ── 인증 (Spring) ────────────────────────────────────────────────────
# JWT 서명 키. HS256 이므로 최소 32바이트(256비트) 이상이어야 하고,
# 짧으면 기동 시 예외가 난다.
# 예시 생성: openssl rand -base64 48
# 운영에서는 절대 기본값을 쓰지 말고 배포 환경변수로 주입할 것.
JWT_SECRET=

# ── 내부 서비스 연동 ─────────────────────────────────────────────────
# Spring 이 Python AI 서비스를 호출할 때 쓰는 주소.
# Python 서비스(8001)는 외부에 노출하지 않는다 — Spring 만 이 주소로 접근한다.
AI_SERVICE_BASE_URL=http://localhost:8001
