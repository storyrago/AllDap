# 이 파일을 .env.local 로 복사해서 쓰세요.
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어갑니다.
# 따라서 API 키·비밀번호 같은 비밀값은 절대 여기에 넣지 마세요.

# Spring API 서버 주소. 브라우저는 이 주소로만 요청합니다.
# Python AI 서비스(:8001)는 외부에 노출하지 않으므로 프론트에서 직접 호출하지 않습니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 랜딩 히어로의 데모 챗봇이 물어볼 봇의 publicKey.
# 미설정 시 pk_local_dev(V1__init.sql 시드 봇)를 쓴다.
# 데모로 보여주려면 문서가 충분히 올라간 봇의 키로 바꿀 것.
NEXT_PUBLIC_DEMO_PUBLIC_KEY=pk_local_dev
