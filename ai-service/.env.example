DATABASE_URL=postgresql://alldap:alldap@localhost:5432/alldap

# Google Gemini — <생성(답변·질문)에만> 쓴다. 임베딩은 아래 Cloudflare 로 옮겼다.
# 발급: https://aistudio.google.com/apikey  (카드 불필요)
GOOGLE_API_KEY=

# 임베딩 — Cloudflare Workers AI (무료 10,000 뉴런/일, 매일 리셋)
# 발급: dash.cloudflare.com → My Profile → API Tokens
#       권한은 Account > Workers AI > Read 하나면 된다
# Account ID 는 대시보드 URL 에 들어 있다: dash.cloudflare.com/<여기>/...
CF_ACCOUNT_ID=
CF_API_TOKEN=
# ⚠️ 모델 변경 시 EMBEDDING_DIM 과 DB 의 VECTOR(n) 을 반드시 함께 변경할 것
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# 생성
CHAT_MODEL=gemini-3.5-flash-lite

TOP_K=5
MAX_DISTANCE=0.55

# 평가 (W3) — 테스트 질문 자동 생성
# 청크 1개당 LLM 을 1번 부르므로 이 값이 곧 비용·응답시간 상한이다.
EVAL_MAX_QUESTIONS=20
# 이보다 짧은 청크(목차·제목 조각)는 표본에서 뺀다.
EVAL_MIN_CHUNK_CHARS=100
