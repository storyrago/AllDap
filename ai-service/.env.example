DATABASE_URL=postgresql://alldap:alldap@localhost:5432/alldap

# Google Gemini — 임베딩과 생성 모두 이 키 하나로 쓴다.
# 발급: https://aistudio.google.com/apikey  (카드 불필요)
GOOGLE_API_KEY=

# 임베딩 (모델 변경 시 EMBEDDING_DIM과 DB의 VECTOR(n)도 함께 변경)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# 생성
CHAT_MODEL=gemini-3.5-flash

TOP_K=5
MAX_DISTANCE=0.55

# 평가 (W3) — 테스트 질문 자동 생성
# 청크 1개당 LLM 을 1번 부르므로 이 값이 곧 비용·응답시간 상한이다.
EVAL_MAX_QUESTIONS=20
# 이보다 짧은 청크(목차·제목 조각)는 표본에서 뺀다.
EVAL_MIN_CHUNK_CHARS=100
