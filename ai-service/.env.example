DATABASE_URL=postgresql://alldap:alldap@localhost:5432/alldap

# Google Gemini — <생성(답변·질문)에만> 쓴다. 임베딩은 아래 Cloudflare 로 옮겼다.
# 발급: https://aistudio.google.com/apikey  (카드 불필요)
GOOGLE_API_KEY=

# 임베딩 — Cloudflare Workers AI (무료 10,000 뉴런/일, 매일 리셋)
# 발급: dash.cloudflare.com → My Profile → API Tokens
#       권한은 Account > Workers AI > Read 하나면 된다
# Account ID 는 대시보드 URL 에 들어 있다: dash.cloudflare.com/<여기>/...
CF_ACCOUNT_ID=
CF_API_TOKEN=

# 부하테스트에서만 쓴다. 비워두면 진짜 Cloudflare 로 간다.
# 가짜 서버: cd ai-service && .venv/bin/python -m loadtest.fake_cf
# CF_BASE_URL=http://127.0.0.1:9001
# ⚠️ 모델 변경 시 EMBEDDING_DIM 과 DB 의 VECTOR(n) 을 반드시 함께 변경할 것
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# 생성
CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# W4 — 리랭커. 기본 off 인 이유는 "미구현"이 아니라 <실측 결과 한국어에서 나빠서>다.
#      (config.py 의 reranker_enabled 주석 참고)
RERANKER_ENABLED=false
RERANK_CANDIDATES=20

TOP_K=5
MAX_DISTANCE=0.55

# 평가 (W3) — 테스트 질문 자동 생성
# 청크 1개당 LLM 을 1번 부르므로 이 값이 곧 비용·응답시간 상한이다.
EVAL_QUESTION_MODEL=gemini-3.5-flash-lite
EVAL_MAX_QUESTIONS=20
# 이보다 짧은 청크(목차·제목 조각)는 표본에서 뺀다.
EVAL_MIN_CHUNK_CHARS=100
# 채점(LLM-as-Judge) 모델 — Cloudflare. ⚠️ CHAT_MODEL 과 반드시 다른 모델이어야 한다
# (자기 답변을 자기가 채점하면 자기 실수를 그대로 통과시킨다)
JUDGE_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# ── FriendliAI (실험용 — 프로덕션 경로가 아니다) ──────────────────────────
# K-EXAONE 같은 국산 모델을 NO_ANSWER 기준으로 재보려고 붙였다.
# 발급: https://friendli.ai → Personal Settings → API Keys
# ⚠️ K-EXAONE 서버리스 Model API 는 2026-08-20 종료 예정이다.
FRIENDLI_TOKEN=
# 여러 팀에 속할 때만. 비우면 기본 팀으로 청구된다.
FRIENDLI_TEAM_ID=
