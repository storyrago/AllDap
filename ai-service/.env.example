DATABASE_URL=postgresql://alldap:alldap@localhost:5432/alldap

# Google Gemini — <생성(답변·질문)에만> 쓴다. 임베딩은 아래 Cloudflare 로 옮겼다.
# 발급: https://aistudio.google.com/apikey  (카드 불필요)
GOOGLE_API_KEY=

# 임베딩 — Cloudflare Workers AI (무료 10,000 뉴런/일, 매일 리셋)
# 발급: dash.cloudflare.com → My Profile → API Tokens
#       권한은 Account > Workers AI > Read 하나면 된다
# Account ID 는 대시보드 URL 에 들어 있다: dash.cloudflare.com/<여기>/...
CF_ACCOUNT_ID=
CF_API_TOKEN=

# 부하테스트에서만 쓴다. 비워두면 진짜 Cloudflare 로 간다.
# 가짜 서버: cd ai-service && .venv/bin/python -m loadtest.fake_cf
# CF_BASE_URL=http://127.0.0.1:9001
# ⚠️ 모델 변경 시 EMBEDDING_DIM 과 DB 의 VECTOR(n) 을 반드시 함께 변경할 것
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# 생성
CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# W4 — 검색 품질. 아래 셋은 2026-08-13 에 <기본값으로 켜기로 결정한> 값이다.
#      근거는 회당 오답이다: 리랭커+하이브리드를 함께 켜면 전체 충실성 0.875(3회 일관) ·
#      회당 오답 0.00 이고, 벡터만 쓰면 0.781 · 회당 오답 1.75 다.
#      fallback 개수는 네 설정 모두 2 로 같으므로 "못 답하는 질문이 느는" 대가가 아니다.
#      바뀌는 것은 fallback 의 <내용물>이고, 그 대가로 <자신 있게 틀린 답>이 사라진다.
#      대가는 채팅 지연 0.67 → 1.56초, 그리고 평가 1회 기준 리랭커 13.6 뉴런(전체의 1.7%).
#      ⚠️ 리랭커는 <하이브리드와 함께일 때만> 이 숫자가 나온다. 단독은 0.844 다.
#      (자세한 기록은 config.py 의 reranker_enabled · hybrid_enabled 주석)
RERANKER_ENABLED=true
RERANK_CANDIDATES=20
HYBRID_ENABLED=true

TOP_K=5
# 근거로 쓸 청크의 임베딩 거리 상한. <낮추지 말 것> — 낮추면 근거가 함께 줄어
# 답이 틀린다(0.45 는 오답 2건, 0.43 은 3건. config.py 의 max_distance 주석).
MAX_DISTANCE=0.55

# 🔴 위 컷과 <다른 일>을 한다. 컷은 "어떤 청크를 근거로 쓸지"(개수)를 정하고,
#    이 값은 "근거가 있기는 한가"(판정)만 본다. 둘은 반대 방향을 원해서 한 값으로
#    겸할 수 없었다 — 그래서 2026-09-06 에 갈랐다.
#    벡터 최근접 거리가 이 값보다 멀면 근거를 통째로 버리고 LLM 을 아예 부르지 않는다.
#    덕분에 1차 방어선(검색컷)이 1/10 → 8/10 으로 살아났고, 평가 16문항은 하나도
#    걸리지 않아 전체충실성·관련성·응답률이 소수점까지 그대로다(= 부작용 없음).
#    ⚠️ 이 값은 코퍼스와 임베딩 모델에 딸려 있다. 둘 중 하나라도 바뀌면 무효이니
#       `.venv/bin/python -m app.answerable_check` 를 다시 돌려 고를 것.
#    🔴 <비워 두지 말 것.> 빈 값·null 은 float 파싱에 실패해 기동이 막힌다(실측).
#       항목을 통째로 지우면 코드 기본값 0.44 가 그대로 쓰인다. 즉 이 환경변수로는
#       게이트를 <끌 수 없다> — 끄려면 config.py 에서 None 으로 둬야 한다.
ANSWERABLE_MAX_DISTANCE=0.44

# 평가 (W3) — 테스트 질문 자동 생성
# 청크 1개당 LLM 을 1번 부르므로 이 값이 곧 비용·응답시간 상한이다.
EVAL_QUESTION_MODEL=gemini-3.5-flash-lite
EVAL_MAX_QUESTIONS=20
# 이보다 짧은 청크(목차·제목 조각)는 표본에서 뺀다.
EVAL_MIN_CHUNK_CHARS=100
# 채점(LLM-as-Judge) 모델 — Cloudflare. ⚠️ CHAT_MODEL 과 반드시 다른 모델이어야 한다
# (자기 답변을 자기가 채점하면 자기 실수를 그대로 통과시킨다)
JUDGE_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# ── FriendliAI (실험용 — 프로덕션 경로가 아니다) ──────────────────────────
# K-EXAONE 같은 국산 모델을 NO_ANSWER 기준으로 재보려고 붙였다.
# 발급: https://friendli.ai → Personal Settings → API Keys
# ⚠️ K-EXAONE 서버리스 Model API 는 2026-08-20 종료 예정이다.
FRIENDLI_TOKEN=
# 여러 팀에 속할 때만. 비우면 기본 팀으로 청구된다.
FRIENDLI_TEAM_ID=
