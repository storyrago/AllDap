# 운영 배포용 환경변수. 서버에 `.env.prod` 로 복사해 채운다.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 🔴 .env.prod 는 절대 커밋하지 않는다 (.dockerignore·.gitignore 로 막아뒀다).
# 🔴 여기 있는 값이 하나라도 비면 <기동이 실패한다>. 의도된 것이다 —
#    application-prod.yaml 과 ai-service/app/config.py 의 _check_prod 가 모두
#    "없으면 시끄럽게 죽는다" 로 짜여 있다. 조용히 잘못된 상태로 뜨는 것보다 안전하다.

# ── 이미지 ────────────────────────────────────────────────────────────
# CI 가 GHCR 에 올린 이미지를 받아 쓴다(.github/workflows/publish.yml).
# 서버(t3.micro 1GB)에서는 Gradle 컴파일이 OOM 이라 빌드를 CI 로 뺐다.
GHCR_REPO=storyrago/alldap
# latest 또는 커밋 SHA. 롤백할 때 SHA 를 박는다.
IMAGE_TAG=latest

# ── 도메인 ────────────────────────────────────────────────────────────
# Caddy 가 이 도메인으로 Let's Encrypt 인증서를 받는다.
# ⚠️ 이 도메인의 A 레코드가 EC2 의 <탄력적 IP> 를 가리켜야 발급된다.
#    무료로 쓰려면 DuckDNS(https://www.duckdns.org) 서브도메인이면 충분하다.
API_DOMAIN=alldap.duckdns.org

# 관리자 화면(Vercel)의 배포 주소. 스킴·호스트가 정확히 일치해야 한다.
# 여러 개면 쉼표로 구분한다(예: 프리뷰 도메인을 함께 허용할 때).
CORS_ALLOWED_ORIGINS=https://alldap.vercel.app

# ── 데이터베이스 (RDS) ────────────────────────────────────────────────
# RDS 콘솔의 "엔드포인트" 를 그대로 넣는다. 포트는 5432 고정.
# ⚠️ EC2 와 <같은 AZ> 에 둘 것 — 다른 AZ 면 데이터 전송에 과금된다.
# ⚠️ 퍼블릭 액세스는 <비활성화>. 보안 그룹에서 EC2 의 SG 로부터만 5432 를 허용한다.
DB_HOST=alldap-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_NAME=alldap
DB_USERNAME=alldap
# ⚠️ 로컬의 alldap/alldap 을 그대로 쓰지 말 것. 예: openssl rand -base64 24
DB_PASSWORD=

# ── 인증 ──────────────────────────────────────────────────────────────
# JWT 서명 키. 길고 무작위여야 한다. 예: openssl rand -base64 48
# 이 값이 새면 아무나 남의 계정 토큰을 만들 수 있다.
JWT_SECRET=

# 결제 수단(토스 빌링키) 암호화 키. Base64 로 인코딩한 32바이트. 예: openssl rand -base64 32
# 🔴 이 값을 잃거나 바꾸면 <이미 등록된 카드를 전부 복호화할 수 없다.>
#    토스에는 발급된 빌링키를 조회하는 API 가 없어 우리 DB 가 유일한 사본이고,
#    잃으면 전 고객이 카드를 다시 등록하는 것 말고는 방법이 없다. 백업해둘 것.
BILLING_CRYPTO_KEY=

# ── 업로드 상한 ───────────────────────────────────────────────────────
# 🔴 1GB 머신에서 이게 OOM 방아쇠다. Python 이 PDF 를 파싱할 때 pymupdf 가
#    파일을 통째로 메모리에 올려서, 20MB 하나에 수백 MB 가 순간적으로 뛴다.
# ⚠️ 두 값을 <함께> 바꿀 것. 한쪽만 낮추면 Spring 은 통과시키고
#    Python 이 413 을 주는 엇갈림이 난다.
UPLOAD_MAX_SIZE=10MB
UPLOAD_MAX_BYTES=10485760

# ── 외부 AI API (Python 서비스만 사용한다) ────────────────────────────
# 임베딩·답변 생성·채점. dash.cloudflare.com → My Profile → API Tokens
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 테스트 질문 생성(gemini). https://aistudio.google.com/apikey
GOOGLE_API_KEY=
